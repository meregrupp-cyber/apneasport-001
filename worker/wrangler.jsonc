{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "apneasport-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  // The website stays on GitHub Pages. This Worker owns one hostname and
  // nothing else, so no workers.dev address is published for it.
  "workers_dev": false,
  "routes": [
    {
      "pattern": "api.apneasport.ee",
      "custom_domain": true,
    },
  ],
  // Applications wait here until the applicant confirms their email address.
  // Created 2026-08-21 in the EEUR region; schema in migrations/.
  "d1_databases": [
    {
      "binding": "ATHLETE_APPLICATIONS",
      "database_name": "apneasport-athlete-applications",
      "database_id": "5e6d0032-2a39-4cb8-b5bb-ea2b9c947bd5",
    },
  ],
  // Plain configuration - none of this is secret. The only secret is
  // RESEND_API_KEY, set with `wrangler secret put RESEND_API_KEY`.
  "vars": {
    "APPLICATION_FROM_EMAIL": "AIDA Estonia <noreply@send.apneasport.ee>",
    "SITE_ORIGIN": "https://apneasport.ee",
    "API_ORIGIN": "https://api.apneasport.ee",
  },
  "observability": {
    "enabled": true,
  },
}
