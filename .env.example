# Public value. The confirmed page URL ships in src/data/site.ts; set this only
# to point an environment at a different page.
PUBLIC_FACEBOOK_PAGE_URL=

# Public value. The website is served by GitHub Pages, so the athlete status
# application form cannot post to its own origin: it calls the Worker at
# https://api.apneasport.ee, which is what the build uses by default. Set this
# only to aim a build at a Worker running elsewhere, such as
# http://127.0.0.1:8787 for a local `wrangler dev`.
PUBLIC_API_BASE_URL=

# Cloudflare secrets / server-only values. Never prefix these with PUBLIC_.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_API_VERSION=

# Athlete status application form. These belong to the api.apneasport.ee
# Worker rather than to the website build, so they are set with
# `wrangler secret put RESEND_API_KEY --config worker/wrangler.jsonc`
# (APPLICATION_FROM_EMAIL is a plain var in worker/wrangler.jsonc). The form
# posts to https://api.apneasport.ee/aida-athlete/apply, which mails the
# applicant a confirmation link and, once that link is opened, mails the
# application to the League. The recipient address is fixed in the Worker and
# is never read from the request.
RESEND_API_KEY=
APPLICATION_FROM_EMAIL=

# Optional. Only for local end to end runs against a fake mail API; leave empty
# in every deployed environment so the real provider is used.
MAIL_API_URL=
