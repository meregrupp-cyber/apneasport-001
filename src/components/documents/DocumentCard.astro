---
interface Props {
  title: string;
  summary?: string | undefined;
  category: string;
  documentType: string;
  locale: string;
  status: string;
  fileUrl: string | null;
  fileSize?: string | undefined;
  version?: string | undefined;
  publishedAt: string | null;
  tags: string[];
  placeholder: boolean;
  uiLocale: 'et' | 'en';
}

const {
  title,
  summary,
  category,
  documentType,
  locale,
  status,
  fileUrl,
  fileSize,
  version,
  publishedAt,
  tags,
  placeholder,
  uiLocale,
} = Astro.props;
const search = [title, summary, category, ...tags]
  .filter(Boolean)
  .join(' ')
  .toLocaleLowerCase(uiLocale);
const dateLabel = publishedAt
  ? new Intl.DateTimeFormat(uiLocale === 'et' ? 'et-EE' : 'en-GB', { dateStyle: 'medium' }).format(
      new Date(`${publishedAt}T00:00:00Z`),
    )
  : null;
const action = uiLocale === 'et' ? 'Ava dokument' : 'Open document';
---

<article
  class:list={['document-card', { 'document-card--placeholder': placeholder }]}
  data-document
  data-search={search}
  data-category={category}
  data-locale={locale}
  data-status={status}
  data-year={publishedAt?.slice(0, 4) ?? ''}
>
  <div class="document-meta">
    <span>{documentType.toUpperCase()}</span>
    <span>{locale.toUpperCase()}</span>
    {fileSize && <span>{fileSize}</span>}
    {version && <span>v {version}</span>}
  </div>
  <h3>{title}</h3>
  {summary && <p>{summary}</p>}
  <div class="document-footer">
    <div>
      <span>{category}</span>
      {dateLabel && <time datetime={publishedAt ?? undefined}>{dateLabel}</time>}
    </div>
    {
      fileUrl ? (
        <a href={fileUrl} download={documentType === 'pdf'}>
          {action}
          <span aria-hidden="true">↓</span>
        </a>
      ) : (
        <span class="pending">
          {uiLocale === 'et' ? 'Lisandub pärast kinnitamist' : 'Pending approval'}
        </span>
      )
    }
  </div>
</article>

<style>
  .document-card {
    display: grid;
    gap: 1rem;
    padding: 1.5rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-foam);
  }
  .document-card--placeholder {
    border-style: dashed;
    background: var(--color-ice);
  }
  .document-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .document-meta span {
    padding: 0.3rem 0.48rem;
    border-radius: 0.35rem;
    color: var(--color-brand);
    background: rgb(7 52 95 / 8%);
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 750;
  }
  .document-card h3 {
    font-size: var(--step-1);
  }
  .document-card > p {
    color: var(--color-muted);
  }
  .document-footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-line);
  }
  .document-footer > div {
    display: flex;
    flex-direction: column;
    color: var(--color-muted);
    font-size: 0.78rem;
  }
  .document-footer a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.45rem;
    color: var(--color-brand);
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 750;
  }
  .pending {
    max-width: 12rem;
    color: var(--color-warning);
    font-size: 0.76rem;
    text-align: right;
  }
  @media (max-width: 34rem) {
    .document-footer {
      align-items: flex-start;
      flex-direction: column;
    }
    .pending {
      text-align: left;
    }
  }
</style>
