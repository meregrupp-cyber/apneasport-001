---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Breadcrumbs from './Breadcrumbs.astro';
import type { Locale } from '../../i18n/routes';

interface Props {
  locale: Locale;
  eyebrow: string;
  title: string;
  intro: string;
  image?: ImageMetadata | undefined;
}
const { locale, eyebrow, title, intro, image } = Astro.props;
---

<header class:list={['page-hero', { 'page-hero--photo': image }]}>
  {
    image ? (
      <div class="page-hero-photo" aria-hidden="true">
        <Image
          src={image}
          alt=""
          widths={[768, 1200, 1600]}
          sizes="100vw"
          format="webp"
          quality={80}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    ) : (
      <div class="page-hero-art" aria-hidden="true">
        <span />
        <span />
      </div>
    )
  }
  <div class="container">
    <Breadcrumbs {locale} current={title} />
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="lede">{intro}</p>
  </div>
</header>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding-block: 10rem 5rem;
    color: var(--color-foam);
    background:
      radial-gradient(circle at 82% 10%, rgb(69 215 196 / 24%), transparent 30%),
      linear-gradient(145deg, var(--color-deep), var(--color-abyss));
    isolation: isolate;
  }
  .page-hero h1 {
    max-width: 14ch;
  }
  .page-hero-art,
  .page-hero-art span {
    position: absolute;
    z-index: -1;
    border-radius: 50%;
  }
  .page-hero-art {
    inset: 0;
  }
  .page-hero-art span:first-child {
    top: 20%;
    right: 8%;
    width: 22rem;
    height: 22rem;
    border: 1px solid rgb(69 215 196 / 25%);
    background: rgb(3 27 44 / 38%);
    box-shadow: inset 0 0 6rem rgb(69 215 196 / 8%);
  }
  .page-hero-art span:last-child {
    top: 44%;
    right: 17%;
    width: 8rem;
    height: 8rem;
    background: rgb(69 215 196 / 9%);
    box-shadow: 0 0 6rem rgb(69 215 196 / 18%);
  }
  .page-hero-photo {
    position: absolute;
    z-index: -1;
    inset: 0;
  }
  .page-hero-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }
  /* Scrim keeps the heading readable while the right side stays open water. */
  .page-hero-photo::after {
    position: absolute;
    inset: 0;
    content: '';
    background:
      linear-gradient(180deg, rgb(2 11 20 / 42%) 0%, transparent 34%, rgb(2 11 20 / 82%) 100%),
      linear-gradient(100deg, rgb(2 11 20 / 66%) 8%, rgb(2 11 20 / 24%) 48%, transparent 76%);
  }
  .page-hero--photo {
    min-height: 34rem;
    display: grid;
    align-items: end;
  }
</style>
