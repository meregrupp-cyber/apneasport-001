---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Breadcrumbs from './Breadcrumbs.astro';
import type { Locale } from '../../i18n/routes';

interface Props {
  locale: Locale;
  eyebrow: string;
  title: string;
  intro: string;
  image?: ImageMetadata | undefined;
}
const { locale, eyebrow, title, intro, image } = Astro.props;
---

<header class:list={['page-hero', { 'page-hero--photo': image }]}>
  {
    image ? (
      <div class="page-hero-photo" aria-hidden="true">
        <Image
          src={image}
          alt=""
          widths={[768, 1200, 1600]}
          sizes="100vw"
          format="webp"
          quality={80}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    ) : (
      <div class="page-hero-art" aria-hidden="true">
        <span />
        <span />
      </div>
    )
  }
  <div class="container">
    <Breadcrumbs {locale} current={title} />
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="lede">{intro}</p>
  </div>
</header>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3.5rem, 7vw, 6rem);
    color: var(--color-foam);
    background: var(--color-ink);
    isolation: isolate;
  }
  .page-hero h1 {
    max-width: 18ch;
    font-size: var(--step-3);
  }
  .page-hero-art,
  .page-hero-art span {
    position: absolute;
    z-index: -1;
    border-radius: 50%;
  }
  .page-hero-art {
    inset: 0;
    opacity: 0.5;
  }
  .page-hero-art span:first-child {
    top: 20%;
    right: 8%;
    width: 22rem;
    height: 22rem;
    border: 1px solid var(--color-line-on-dark);
  }
  .page-hero-art span:last-child {
    top: 44%;
    right: 17%;
    width: 8rem;
    height: 8rem;
    background: rgb(245 244 239 / 6%);
  }
  .page-hero-photo {
    position: absolute;
    z-index: -1;
    inset: 0;
  }
  .page-hero-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }
  /* Scrim keeps the heading readable while the right side stays open water. */
  .page-hero-photo::after {
    position: absolute;
    inset: 0;
    content: '';
    background:
      linear-gradient(180deg, rgb(14 31 41 / 38%) 0%, transparent 36%, rgb(14 31 41 / 80%) 100%),
      linear-gradient(100deg, rgb(14 31 41 / 68%) 8%, rgb(14 31 41 / 28%) 50%, transparent 78%);
  }
  .page-hero--photo {
    min-height: 26rem;
    display: grid;
    align-items: end;
  }
</style>
