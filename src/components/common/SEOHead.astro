---
import { routeFor, type Locale, type RouteKey } from '../../i18n/routes';
import { site } from '../../data/site';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  routeKey: RouteKey;
  image?: string;
  /** Overrides the routeKey paths for pages that live under a dynamic route. */
  paths?: { et: string; en: string };
}

const {
  title,
  description,
  locale,
  routeKey,
  image = '/brand/eapsl-logo-v3.png',
  paths,
} = Astro.props;
const pathFor = (target: Locale) => paths?.[target] ?? routeFor(routeKey, target);
const pageTitle = `${title} | ${site.shortName}`;
const canonical = new URL(pathFor(locale), site.baseUrl).href;
const etUrl = new URL(pathFor('et'), site.baseUrl).href;
const enUrl = new URL(pathFor('en'), site.baseUrl).href;
const imageUrl = new URL(image, site.baseUrl).href;
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang="et" href={etUrl} />
<link rel="alternate" hreflang="en" href={enUrl} />
<link rel="alternate" hreflang="x-default" href={etUrl} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.legalName[locale]} />
<meta property="og:locale" content={locale === 'et' ? 'et_EE' : 'en_GB'} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
