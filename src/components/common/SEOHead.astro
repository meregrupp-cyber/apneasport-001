---
import { routeFor, type Locale, type RouteKey } from '../../i18n/routes';
import { site } from '../../data/site';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  routeKey: RouteKey;
  image?: string;
}

const { title, description, locale, routeKey, image = '/brand/eapsl-mark.webp' } = Astro.props;
const pageTitle = `${title} | ${site.shortName}`;
const canonical = new URL(routeFor(routeKey, locale), site.baseUrl).href;
const etUrl = new URL(routeFor(routeKey, 'et'), site.baseUrl).href;
const enUrl = new URL(routeFor(routeKey, 'en'), site.baseUrl).href;
const imageUrl = new URL(image, site.baseUrl).href;
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang="et" href={etUrl} />
<link rel="alternate" hreflang="en" href={enUrl} />
<link rel="alternate" hreflang="x-default" href={etUrl} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.legalName[locale]} />
<meta property="og:locale" content={locale === 'et' ? 'et_EE' : 'en_GB'} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
