---
import { render, type CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { routeFor, type Locale, type RouteKey } from '../../i18n/routes';
import { t } from '../../i18n/ui';
import freedivingImage from '../../assets/eapsl/freediving.png';
import mermaidingImage from '../../assets/eapsl/mermaiding.png';
import waterfightingImage from '../../assets/eapsl/waterfighting.png';
import PageHero from '../common/PageHero.astro';
import AthleteApplication from './AthleteApplication.astro';
import AthleteRecordsTable from './AthleteRecordsTable.astro';

interface Props {
  entry: CollectionEntry<'sports'>;
  routeKey: RouteKey;
  locale: Locale;
}

const { entry, locale } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;
const copy = t(locale);
const sportImages: Record<string, ImageMetadata> = {
  'sport-freediving': freedivingImage,
  'sport-mermaiding': mermaidingImage,
  'sport-waterfighting': waterfightingImage,
};
const heroImage = sportImages[data.translationKey];
const labels =
  locale === 'et'
    ? {
        what: 'Mis ala see on?',
        who: 'Kellele see sobib?',
        start: 'Kuidas alustada?',
        disciplines: 'Põhidistsipliinid',
        safety: 'Ohutus',
        training: 'Treening ja kvalifikatsioon',
        competition: 'Võistlemine',
        athletes: 'Sportlased ja rekordid',
        athletesIntro:
          'Tulemused, rekordid ja rankingud pärinevad AIDA Internationali ametlikest allikatest; kinnitamata väli on tähistatud sümboliga —. Sportlase nimi avab tema profiili.',
        official: 'Ametlikud välislingid',
        contact: 'Leia treeninguvõimalus',
      }
    : {
        what: 'What is it?',
        who: 'Who is it for?',
        start: 'How to begin',
        disciplines: 'Core disciplines',
        safety: 'Safety',
        training: 'Training and qualifications',
        competition: 'Competition',
        athletes: 'Athletes and records',
        athletesIntro:
          'Results, records and rankings come from official AIDA International sources; a field awaiting confirmation is marked with —. The athlete name opens their profile.',
        official: 'Official external links',
        contact: 'Find a training opportunity',
      };
// The athlete registry is an AIDA Estonia responsibility, so it stays on the
// freediving page only.
const showAthletes = data.translationKey === 'sport-freediving';
const athletesAnchor = locale === 'et' ? 'sportlased-ja-rekordid' : 'athletes-and-records';
// The first seven sections keep their published `#section-N` anchors; anything
// added later gets a stable named anchor instead.
const tableOfContents = [
  { label: labels.what, href: '#section-1' },
  { label: labels.who, href: '#section-2' },
  { label: labels.start, href: '#section-3' },
  { label: labels.disciplines, href: '#section-4' },
  { label: labels.safety, href: '#section-5' },
  { label: labels.training, href: '#section-6' },
  { label: labels.competition, href: '#section-7' },
  ...(showAthletes ? [{ label: labels.athletes, href: `#${athletesAnchor}` }] : []),
];
---

<PageHero
  {locale}
  eyebrow={data.eyebrow}
  title={data.title}
  intro={data.summary}
  image={heroImage}
/>
<article class="section sport-detail">
  <div class="container sport-layout">
    <aside>
      <p class="eyebrow">{locale === 'et' ? 'Lehel' : 'On this page'}</p>
      <nav aria-label={locale === 'et' ? 'Lehe sisukord' : 'Table of contents'}>
        {tableOfContents.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </aside>
    <div class="sport-content">
      <section id="section-1">
        <h2>{labels.what}</h2><p>{data.definition}</p><div class="prose-body"><Content /></div>
      </section>
      <section id="section-2">
        <h2>{labels.who}</h2><ul>{data.suitedFor.map((item) => <li>{item}</li>)}</ul>
      </section>
      <section id="section-3">
        <h2>{labels.start}</h2><ol>{data.startSteps.map((item) => <li>{item}</li>)}</ol>
      </section>
      <section id="section-4">
        <h2>{labels.disciplines}</h2><ul>{data.disciplines.map((item) => <li>{item}</li>)}</ul>
      </section>
      <section id="section-5" class="safety-section">
        <h2>{labels.safety}</h2><ul>{data.safety.map((item) => <li>{item}</li>)}</ul>
      </section>
      <section id="section-6"><h2>{labels.training}</h2><p>{data.qualification}</p></section>
      <section id="section-7"><h2>{labels.competition}</h2><p>{data.competition}</p></section>
      {
        showAthletes && (
          <section id={athletesAnchor}>
            <h2>{labels.athletes}</h2>
            <p>{labels.athletesIntro}</p>
            <AthleteRecordsTable {locale} />
            <AthleteApplication {locale} />
          </section>
        )
      }
      {
        data.officialLinks.length > 0 && (
          <section>
            <>
              <h2>{labels.official}</h2>
              <div class="button-row">
                {data.officialLinks.map((link) => (
                  <a
                    class="button button--ghost"
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {link.label}
                    <span aria-hidden="true">↗</span>
                  </a>
                ))}
              </div>
            </>
          </section>
        )
      }
      <aside class="contact-cta">
        <div>
          <h2>{labels.contact}</h2><p>
            {
              locale === 'et'
                ? 'Alusta liikmesklubist või küsi EAPSL-ilt kinnitatud kontakti.'
                : 'Start with a member club or ask EAPSL for an approved contact.'
            }
          </p>
        </div><a class="button button--primary" href={routeFor('contact', locale)}
          >{locale === 'et' ? 'Võta ühendust' : 'Contact us'}<span aria-hidden="true">→</span></a
        >
      </aside>
      <p class="legal-note">{copy.legalDocumentNote}</p>
    </div>
  </div>
</article>

<style>
  .sport-layout {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    align-items: start;
    gap: clamp(2rem, 7vw, 7rem);
  }
  .sport-layout > aside {
    position: sticky;
    top: 1.5rem;
  }
  .sport-layout > aside nav {
    display: grid;
  }
  .sport-layout > aside a {
    padding-block: 0.55rem;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-muted);
    font-size: 0.82rem;
    text-decoration: none;
  }
  .sport-content {
    display: grid;
    gap: var(--space-7);
  }
  .sport-content > section {
    display: grid;
    gap: 1.25rem;
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-line);
    scroll-margin-top: 2rem;
  }
  .sport-content h2 {
    font-size: var(--step-2);
  }
  .sport-content p,
  .sport-content li {
    max-width: 68ch;
  }
  .sport-content ul,
  .sport-content ol {
    display: grid;
    gap: 0.7rem;
    padding-left: 1.35rem;
    margin: 0;
  }
  .safety-section {
    padding: clamp(1.25rem, 4vw, 2.5rem);
    border: 0 !important;
    border-radius: var(--radius-md);
    color: var(--color-foam);
    background: var(--color-deep);
  }
  .contact-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(1.25rem, 4vw, 2.5rem);
    border-radius: var(--radius-md);
    background: var(--color-brand);
    color: var(--color-foam);
  }
  .contact-cta p {
    margin-top: 0.75rem;
    color: rgb(242 247 248 / 74%);
  }
  @media (max-width: 50rem) {
    .sport-layout {
      grid-template-columns: 1fr;
    }
    .sport-layout > aside {
      position: static;
    }
    .contact-cta {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
