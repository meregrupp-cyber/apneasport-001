---
import {
  athleteName,
  athleteSlug,
  athletesByLastName,
  disciplineCodes,
  recordSummary,
  unknownValue,
  type Athlete,
  type AthleteEntry,
} from '../../data/athletes';
import type { Locale } from '../../i18n/routes';
import AthleteModal from './AthleteModal.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const athletes = athletesByLastName();
const labels =
  locale === 'et'
    ? {
        athlete: 'Sportlane',
        sex: 'Sugu',
        status: 'Staatus',
        nationalRecord: 'Eesti rekord',
        worldRecord: 'Maailmarekord',
        aidaProfile: 'AIDA profiil',
        caption:
          'Vabasukeldumise sportlaste register: staatus, distsipliinide tulemused ja rekordid. Kinnitamata väli on tähistatud sümboliga —. Sportlase nimi avab tema profiili.',
      }
    : {
        athlete: 'Athlete',
        sex: 'Sex',
        status: 'Status',
        nationalRecord: 'National record',
        worldRecord: 'World record',
        aidaProfile: 'AIDA profile',
        caption:
          'Freediving athlete registry: status, discipline results and records. A field awaiting approval is marked with —. The athlete name opens their profile.',
      };

interface Column {
  label: string;
  /** AIDA discipline abbreviations stay untranslated and share one column width. */
  code?: boolean;
  /** Single read path per cell, so a value, a date, a venue or a link is added in one place. */
  value: (athlete: Athlete) => AthleteEntry | undefined;
}

const columns: Column[] = [
  ...disciplineCodes.map((discipline) => ({
    label: discipline,
    code: true,
    value: (athlete: Athlete) => athlete.disciplines[discipline]?.pb,
  })),
  { label: labels.nationalRecord, value: (athlete) => recordSummary(athlete.nationalRecords) },
  { label: labels.worldRecord, value: (athlete) => recordSummary(athlete.worldRecords) },
  { label: labels.aidaProfile, value: (athlete) => athlete.aidaProfile },
];
const captionId = 'athlete-table-caption';
---

<div class="data-scroller athlete-panel" role="region" tabindex="0" aria-labelledby={captionId}>
  <table class="data-table athlete-table">
    <caption id={captionId} class="visually-hidden">{labels.caption}</caption>
    <thead>
      <tr>
        <th scope="col" class="athlete-name">{labels.athlete}</th>
        <th scope="col" class="athlete-narrow">{labels.sex}</th>
        <th scope="col">{labels.status}</th>
        {
          columns.map((column) => (
            <th scope="col" class:list={[{ 'athlete-code': column.code }]}>
              {column.label}
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        athletes.map((athlete) => (
          <tr>
            <th scope="row" class="athlete-name">
              <button
                type="button"
                class="athlete-name-button"
                data-athlete-modal-open={`athlete-${athleteSlug(athlete)}`}
                disabled
              >
                {athleteName(athlete)}
              </button>
            </th>
            <td class="athlete-narrow">{athlete.sex}</td>
            <td>
              <span class:list={['status-pill', `status-pill--${athlete.status.toLowerCase()}`]}>
                {athlete.status}
              </span>
            </td>
            {columns.map((column) => {
              const entry = column.value(athlete);
              return (
                <td class:list={[{ 'athlete-code': column.code, 'athlete-unknown': !entry }]}>
                  {entry ? (
                    entry.url ? (
                      <a href={entry.url}>{entry.value}</a>
                    ) : (
                      entry.value
                    )
                  ) : (
                    unknownValue
                  )}
                </td>
              );
            })}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
{athletes.map((athlete) => <AthleteModal {athlete} {locale} />)}

<script>
  import { initialiseAthleteModals } from '../../scripts/athlete-modal';
  initialiseAthleteModals();
</script>

<style>
  /* The frame is the scroll container, so nothing clips its focus ring. */
  .athlete-panel {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background-color: var(--color-foam);
  }
  /* The name stays in view while the results scroll past it. */
  .athlete-name {
    position: sticky;
    left: 0;
    min-width: 11.5rem;
    box-shadow: 1px 0 0 var(--color-line);
  }
  thead .athlete-name {
    z-index: 2;
  }
  tbody .athlete-name {
    z-index: 1;
    color: var(--color-ink);
    background: var(--color-foam);
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  /* Reads as the athlete name; the underline only appears once the dialog
     script has enabled it. */
  .athlete-name-button {
    padding: 0;
    border: 0;
    color: inherit;
    background: none;
    font: inherit;
    text-align: left;
  }
  .athlete-name-button:enabled {
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: var(--color-line);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.18em;
  }
  .athlete-name-button:enabled:hover {
    text-decoration-color: var(--color-aqua-dark);
  }
  .athlete-narrow {
    width: 1%;
  }
  .athlete-code {
    min-width: 4.25rem;
  }
  .athlete-unknown {
    color: var(--color-muted);
  }
  @media (max-width: 38rem) {
    .athlete-name {
      min-width: 10.5rem;
    }
    tbody .athlete-name {
      font-size: 0.9rem;
    }
  }
</style>
