---
import { getCollection } from 'astro:content';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { routeFor, type Locale } from '../../i18n/routes';
import { t } from '../../i18n/ui';
import freedivingImage from '../../assets/eapsl/freediving.png';
import mermaidingImage from '../../assets/eapsl/mermaiding.png';
import waterfightingImage from '../../assets/eapsl/waterfighting.png';
import { newsPath, publishedNews } from '../../data/news';
import HeroDepthScene from './HeroDepthScene.astro';
import TrustStrip from './TrustStrip.astro';
import SportShowcase from './SportShowcase.astro';
import NewsCard from '../news/NewsCard.astro';
import SafetyIntegrityPanel from './SafetyIntegrityPanel.astro';
import AidaNetworkSection from './AidaNetworkSection.astro';
import ClubFeatureCard from './ClubFeatureCard.astro';
import TrainingPathCard from './TrainingPathCard.astro';
import ContactPanel from './ContactPanel.astro';
import DocumentCard from '../documents/DocumentCard.astro';
import SocialFeedFallback from '../news/SocialFeedFallback.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = t(locale);
const sportOrder = ['sport-freediving', 'sport-mermaiding', 'sport-waterfighting'];
const sports = (await getCollection('sports'))
  .filter((entry) => entry.data.locale === locale)
  .sort(
    (a, b) => sportOrder.indexOf(a.data.translationKey) - sportOrder.indexOf(b.data.translationKey),
  );
const clubs = (await getCollection('clubs'))
  .filter((entry) => entry.data.locale === locale && entry.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const documents = (await getCollection('documents')).filter((entry) => entry.data.featured);
const news = (await publishedNews(locale)).slice(0, 3);

const sportRoute = (translationKey: string) => {
  if (translationKey === 'sport-freediving') return routeFor('freediving', locale);
  if (translationKey === 'sport-waterfighting') return routeFor('waterfighting', locale);
  return routeFor('mermaiding', locale);
};

const sportVisuals: Record<string, { image: ImageMetadata; alt: { et: string; en: string } }> = {
  'sport-freediving': {
    image: freedivingImage,
    alt: {
      et: 'Vabasukeldujad treenimas vee all',
      en: 'Freediving athletes training underwater',
    },
  },
  'sport-mermaiding': {
    image: mermaidingImage,
    alt: {
      et: 'Merineitsisportlane esinemas vee all monolestaga',
      en: 'Mermaiding athlete performing underwater with a monofin',
    },
  },
  'sport-waterfighting': {
    image: waterfightingImage,
    alt: {
      et: 'Veevõitlussportlased treenimas vee all',
      en: 'Waterfighting athletes training underwater',
    },
  },
};

const home =
  locale === 'et'
    ? {
        title: 'Eesti Apneaspordi Liit',
        description:
          'Eesti Apneaspordi Liit arendab vabasukeldumist, veevõitlust ja merineitsisporti ohutult, ausalt ja avatult.',
        aboutEyebrow: 'Mis on EAPSL?',
        aboutTitle: 'Ühine ruum oskusele, ohutusele ja arengule.',
        aboutText:
          'Loome Eestis ohutud, ausad ja üldkättesaadavad tingimused apneasportide harrastamiseks, treenimiseks, võistlemiseks ja rahvusvaheliseks esindamiseks.',
        aboutCta: 'Tutvu eesmärkidega',
        sportSafety: {
          'sport-freediving': 'Ära sukeldu üksi',
          'sport-mermaiding': 'Pädev järelevalve',
          'sport-waterfighting': 'Juhendatud treening',
        } as Record<string, string>,
        clubEyebrow: 'Liikmesklubid',
        clubTitle: 'Sport kasvab klubides.',
        clubText:
          'Liikmesklubid loovad treeningukeskkonna, kus huviline saab alustada ning sportlane edasi areneda.',
        trainingEyebrow: 'Treenerid ja koolitused',
        trainingTitle: 'Vali õige õpitee.',
        trainingCards: [
          {
            title: 'Treenerikutse info',
            text: 'Ametlik roll, tasemed ja nõuded lisanduvad pärast kinnitamist.',
            route: 'qualification' as const,
          },
          {
            title: 'AIDA koolitustee',
            text: 'Rahvusvaheline vabasukeldumise kursuste ja kvalifikatsioonide süsteem.',
            route: 'aidaEducation' as const,
          },
          {
            title: 'Koolituste kalender',
            text: 'Avaldatavad koolitused ja registreerimisinfo ühes vaates.',
            route: 'trainingCalendar' as const,
          },
        ],
        docsEyebrow: 'Ametlik info',
        docsTitle: 'Alusdokumendid, vaata teegist.',
        docsText:
          'Põhikiri on avaldatud; järgmised kinnitatud dokumendid lisanduvad struktureeritud arhiivi.',
        docsCta: 'Ava dokumendiarhiiv',
        newsEyebrow: 'Uudised',
        newsTitle: 'EAPSL-i enda uudistearhiiv.',
        newsCta: 'Vaata kõiki uudiseid',
        noNews:
          'Esimesed kinnitatud uudised lisanduvad siia. Mustandeid ega Facebooki postitusi automaatselt ei avaldata.',
      }
    : {
        title: 'Estonian Apnea Sports League',
        description:
          'The Estonian Apnea Sports League develops freediving, waterfighting and mermaiding safely, fairly and openly.',
        aboutEyebrow: 'What is EAPSL?',
        aboutTitle: 'A shared space for skill, safety and progress.',
        aboutText:
          'We create safe, fair and accessible conditions in Estonia for practising, training, competing and representing apnea sports internationally.',
        aboutCta: 'Explore our mission',
        sportSafety: {
          'sport-freediving': 'Never dive alone',
          'sport-mermaiding': 'Competent supervision',
          'sport-waterfighting': 'Supervised training',
        } as Record<string, string>,
        clubEyebrow: 'Member clubs',
        clubTitle: 'Sport grows in clubs.',
        clubText:
          'Member clubs create the training environment where newcomers can begin and athletes can progress.',
        trainingEyebrow: 'Coaches and education',
        trainingTitle: 'Choose the right pathway.',
        trainingCards: [
          {
            title: 'Professional qualification',
            text: 'The official role, levels and requirements will be added after approval.',
            route: 'qualification' as const,
          },
          {
            title: 'AIDA education pathway',
            text: 'The international system of freediving courses and qualifications.',
            route: 'aidaEducation' as const,
          },
          {
            title: 'Training calendar',
            text: 'Publishable courses and registration information in one view.',
            route: 'trainingCalendar' as const,
          },
        ],
        docsEyebrow: 'Official information',
        docsTitle: 'Founding documents, see the library.',
        docsText:
          'The Statutes are published; further approved documents will join the structured archive.',
        docsCta: 'Open document archive',
        newsEyebrow: 'News',
        newsTitle: 'EAPSL’s own news archive.',
        newsCta: 'See all news',
        noNews:
          'The first approved news items will appear here. Drafts and Facebook posts are not published automatically.',
      };
---

<BaseLayout title={home.title} description={home.description} {locale} routeKey="home">
  <main id="main-content">
    <HeroDepthScene {locale} />
    <TrustStrip {locale} />

    <section class="section about-section">
      <div class="container about-grid">
        <div>
          <p class="eyebrow">{home.aboutEyebrow}</p>
          <h2>{home.aboutTitle}</h2>
        </div>
        <div>
          <p class="lede">{home.aboutText}</p>
          <a class="button button--secondary" href={routeFor('mission', locale)}
            >{home.aboutCta}<span aria-hidden="true">→</span></a
          >
        </div>
      </div>
    </section>

    <section class="section sports-section">
      <div class="container sport-flow">
        {
          sports.map((sport, index) => (
            <SportShowcase
              title={sport.data.title}
              summary={sport.data.summary}
              safety={home.sportSafety[sport.data.translationKey] ?? ''}
              href={sportRoute(sport.data.translationKey)}
              index={`0${index + 1}`}
              accent={sport.data.accent}
              cta={copy.learnMore}
              image={sportVisuals[sport.data.translationKey]?.image ?? freedivingImage}
              imageAlt={sportVisuals[sport.data.translationKey]?.alt[locale] ?? ''}
              flip={index % 2 === 1}
              dynamic={sport.data.translationKey === 'sport-waterfighting'}
              logoSrc={
                sport.data.translationKey === 'sport-freediving'
                  ? '/brand/aida-logo-negative.svg'
                  : undefined
              }
            />
          ))
        }
      </div>
    </section>

    <section class="section section--ice">
      <div class="container"><SafetyIntegrityPanel {locale} /></div>
    </section>
    <AidaNetworkSection {locale} />

    <section class="section section--ice">
      <div class="container section-heading">
        <p class="eyebrow">{home.clubEyebrow}</p>
        <h2>{home.clubTitle}</h2>
        <p class="lede">{home.clubText}</p>
      </div>
      <div class="container club-wrap">
        {clubs.map((club) => <ClubFeatureCard {...club.data} {locale} />)}
      </div>
    </section>

    <section class="section training-section">
      <div class="container section-heading">
        <p class="eyebrow">{home.trainingEyebrow}</p>
        <h2>{home.trainingTitle}</h2>
      </div>
      <div class="container grid grid--3">
        {
          home.trainingCards.map((card, index) => (
            <TrainingPathCard
              number={`0${index + 1}`}
              title={card.title}
              text={card.text}
              href={routeFor(card.route, locale)}
              cta={copy.learnMore}
            />
          ))
        }
      </div>
    </section>

    <section class="section section--ice documents-section">
      <div class="container docs-layout">
        <div>
          <p class="eyebrow">{home.docsEyebrow}</p>
          <h2>{home.docsTitle}</h2>
          <p class="lede">{home.docsText}</p>
          <a class="button button--ink" href={routeFor('documents', locale)}
            >{home.docsCta}<span aria-hidden="true">→</span></a
          >
        </div>
        <div class="home-documents">
          {documents.map((document) => <DocumentCard {...document.data} uiLocale={locale} />)}
        </div>
      </div>
    </section>

    <section class="section news-section">
      <div class="container section-heading">
        <p class="eyebrow">{home.newsEyebrow}</p>
        <h2>{home.newsTitle}</h2>
      </div>
      <div class="container news-empty">
        {news.length === 0 && <p class="status-note">{home.noNews}</p>}
        {
          news.length > 0 && (
            <div class="home-news">
              {news.map((entry) => (
                <NewsCard
                  {locale}
                  title={entry.data.title}
                  excerpt={entry.data.excerpt}
                  publishedAt={entry.data.publishedAt}
                  href={newsPath(entry)}
                  author={entry.data.author}
                  image={entry.data.image}
                  imageAlt={entry.data.imageAlt}
                  cta={copy.learnMore}
                />
              ))}
              <a class="button button--ghost" href={routeFor('news', locale)}>
                {home.newsCta}
                <span aria-hidden="true">→</span>
              </a>
            </div>
          )
        }
      </div>
      <div class="container"><SocialFeedFallback {locale} /></div>
    </section>

    <section class="section section--compact">
      <div class="container"><ContactPanel {locale} /></div>
    </section>
  </main>
</BaseLayout>

<style>
  .about-section {
    background: var(--color-paper);
  }
  .sports-section {
    padding-block: clamp(4rem, 8vw, 8rem);
    background: var(--color-paper);
    border-top: 1px solid var(--color-line);
  }
  .about-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    align-items: end;
    gap: clamp(2rem, 8vw, 8rem);
  }
  .about-grid .button {
    margin-top: 1.75rem;
  }
  .section-heading {
    margin-bottom: var(--space-6);
  }
  .section-heading h2 {
    max-width: 16ch;
  }
  .sport-flow {
    display: grid;
    gap: clamp(4.5rem, 8vw, 8.5rem);
    margin-top: var(--space-7);
  }
  .club-wrap {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }
  .training-section .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
  }
  .docs-layout {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(2rem, 8vw, 8rem);
  }
  .docs-layout .button {
    margin-top: var(--space-5);
  }
  .home-documents {
    display: grid;
    gap: 1rem;
  }
  .news-empty {
    margin-bottom: var(--space-4);
  }
  .home-news {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
  }
  @media (max-width: 52rem) {
    .about-grid,
    .docs-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
