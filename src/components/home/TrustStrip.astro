---
import type { Locale } from '../../i18n/routes';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const items =
  locale === 'et'
    ? [
        'AIDA Internationali liige',
        'Ohutus ennekõike',
        'Aus ja avatud sport',
        'Eesti ja inglise keeles',
      ]
    : [
        'Member of AIDA International',
        'Safety first',
        'Fair and open sport',
        'In Estonian and English',
      ];
---

<div class="trust-strip" id="trust-strip">
  <div class="container">
    {
      items.map((item, index) => (
        <div>
          <>
            <span aria-hidden="true">0{index + 1}</span>
            <strong>{item}</strong>
          </>
        </div>
      ))
    }
  </div>
</div>

<style>
  .trust-strip {
    border-bottom: 1px solid var(--color-line);
    background: var(--color-foam);
  }

  .trust-strip .container {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .trust-strip .container > div {
    display: flex;
    min-height: 6.5rem;
    align-items: center;
    gap: 0.8rem;
    padding: 1rem;
    border-right: 1px solid var(--color-line);
  }

  .trust-strip .container > div:first-child {
    border-left: 1px solid var(--color-line);
  }

  .trust-strip span {
    color: var(--color-aqua-dark);
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 750;
  }

  .trust-strip strong {
    font-family: var(--font-display);
    font-size: 0.86rem;
    line-height: 1.3;
  }

  @media (max-width: 48rem) {
    .trust-strip .container {
      grid-template-columns: 1fr 1fr;
    }

    .trust-strip .container > div {
      min-height: 5rem;
      border-bottom: 1px solid var(--color-line);
    }
  }

  @media (max-width: 28rem) {
    .trust-strip .container {
      grid-template-columns: 1fr;
    }
  }
</style>
