---
import type { Locale } from '../../i18n/routes';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const items =
  locale === 'et'
    ? [
        'AIDA Internationali liige',
        'Ohutus ennekõike',
        'Aus ja avatud sport',
        'Eesti ja inglise keeles',
      ]
    : [
        'Member of AIDA International',
        'Safety first',
        'Fair and open sport',
        'In Estonian and English',
      ];
---

<div class="trust-strip" id="trust-strip">
  <div class="container">
    {
      items.map((item, index) => (
        <div>
          <>
            <span aria-hidden="true">0{index + 1}</span>
            <strong>{item}</strong>
          </>
        </div>
      ))
    }
  </div>
</div>

<style>
  /* A straight, clear boundary under the hero photo. */
  .trust-strip {
    color: var(--color-ink);
    background: var(--color-paper);
    border-bottom: 1px solid var(--color-line);
  }

  .trust-strip .container {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .trust-strip .container > div {
    display: flex;
    min-height: 5.5rem;
    align-items: center;
    gap: 0.8rem;
    padding: 1rem 1.25rem 1rem 0;
    border-right: 1px solid var(--color-line);
  }

  .trust-strip .container > div:last-child {
    border-right: 0;
  }

  .trust-strip .container > div + div {
    padding-left: 1.25rem;
  }

  .trust-strip span {
    color: var(--color-accent);
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .trust-strip strong {
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 0.86rem;
    font-weight: 600;
    line-height: 1.3;
  }

  @media (max-width: 48rem) {
    .trust-strip .container {
      grid-template-columns: 1fr 1fr;
    }

    .trust-strip .container > div {
      min-height: 4.5rem;
      padding-inline: 0 1rem;
      border-bottom: 1px solid var(--color-line);
    }

    .trust-strip .container > div:nth-child(2n) {
      padding-left: 1rem;
      border-right: 0;
    }

    .trust-strip .container > div:nth-last-child(-n + 2) {
      border-bottom: 0;
    }
  }

  @media (max-width: 26rem) {
    .trust-strip .container {
      grid-template-columns: 1fr;
    }

    .trust-strip .container > div {
      padding-left: 0;
      border-right: 0;
      border-bottom: 1px solid var(--color-line);
    }

    .trust-strip .container > div:last-child {
      border-bottom: 0;
    }
  }
</style>
