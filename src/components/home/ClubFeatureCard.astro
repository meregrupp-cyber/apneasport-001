---
interface Props {
  name: string;
  summary: string;
  website: string;
  logo: string;
  locale: 'et' | 'en';
}

const { name, summary, website, logo, locale } = Astro.props;
// Until a club supplies its own mark, the plate carries the club name so every
// card keeps the same shape and weight in the list.
const wordmark = name.replace(/^(Spordiklubi|Spordikool|Sports Club)\s+/i, '');
---

<a class="club-card" href={website} target="_blank" rel="noopener noreferrer">
  <div class="club-logo">
    {
      logo ? (
        <img
          src={logo}
          alt={`${name} logo`}
          width="360"
          height="120"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <span class="club-wordmark">{wordmark}</span>
      )
    }
  </div>
  <div class="club-copy">
    <p class="eyebrow">{locale === 'et' ? 'Liikmesklubi' : 'Member club'}</p>
    <h3>{name}</h3>
    <p>{summary}</p>
    <span
      >{locale === 'et' ? 'Külasta klubi veebilehte' : 'Visit the club website'}
      <b aria-hidden="true">↗</b></span
    >
  </div>
</a>

<style>
  .club-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(11rem, 0.7fr) 1.3fr;
    align-items: center;
    gap: clamp(1.5rem, 5vw, 4rem);
    padding: clamp(1.25rem, 3vw, 2.25rem);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    color: var(--color-ink);
    background: var(--color-foam);
    text-decoration: none;
    transition: border-color 180ms ease;
  }

  .club-card:hover {
    border-color: var(--color-line-firm);
  }

  .club-logo {
    display: grid;
    min-height: 8.5rem;
    place-items: center;
    padding: 1rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    background: var(--color-foam);
  }

  .club-logo img {
    width: min(100%, 14rem);
    height: auto;
    max-height: 6.5rem;
    border-radius: var(--radius-sm);
    object-fit: contain;
  }

  .club-wordmark {
    color: var(--color-accent);
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1rem + 0.9vw, 1.6rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    text-align: center;
    text-wrap: balance;
  }

  .club-copy h3 {
    color: var(--color-ink);
    font-size: var(--step-2);
  }

  .club-copy p:not(.eyebrow) {
    max-width: 48rem;
    margin-top: 0.75rem;
    color: var(--color-muted);
  }

  .club-copy > span {
    display: inline-block;
    margin-top: 1.25rem;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.35em;
  }

  .club-card:hover .club-copy > span {
    color: var(--color-accent);
  }

  @media (max-width: 48rem) {
    .club-card {
      grid-template-columns: 1fr;
    }

    .club-logo {
      min-height: 7rem;
      justify-self: start;
      width: min(100%, 15rem);
    }
  }
</style>
