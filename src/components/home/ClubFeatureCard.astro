---
interface Props {
  name: string;
  summary: string;
  website: string;
  logo: string;
  locale: 'et' | 'en';
}

const { name, summary, website, logo, locale } = Astro.props;
---

<a class="club-card" href={website} target="_blank" rel="noopener noreferrer" data-tilt>
  <div class="club-art" aria-hidden="true"><span></span><span></span><span></span></div>
  <div class="club-logo">
    <img src={logo} alt={`${name} logo`} width="360" height="120" loading="lazy" decoding="async" />
  </div>
  <div class="club-copy">
    <p class="eyebrow">{locale === 'et' ? 'Liikmesklubi' : 'Member club'}</p>
    <h3>{name}</h3>
    <p>{summary}</p>
    <span
      >{locale === 'et' ? 'Külasta klubi veebilehte' : 'Visit the club website'}
      <b aria-hidden="true">↗</b></span
    >
  </div>
</a>

<style>
  .club-card {
    position: relative;
    display: grid;
    min-height: 28rem;
    grid-template-columns: minmax(12rem, 0.8fr) 1.2fr;
    align-items: end;
    gap: clamp(2rem, 6vw, 6rem);
    overflow: hidden;
    padding: clamp(1.5rem, 5vw, 4.5rem);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    color: var(--color-foam);
    background: linear-gradient(115deg, rgb(2 11 20 / 96%), rgb(7 52 95 / 82%)), var(--color-brand);
    box-shadow: var(--shadow-soft);
    text-decoration: none;
    isolation: isolate;
  }

  .club-logo {
    position: relative;
    z-index: 2;
    display: grid;
    min-height: 12rem;
    place-items: center;
    padding: 1.5rem;
    border: 1px solid rgb(255 255 255 / 17%);
    border-radius: var(--radius-md);
    background: rgb(255 255 255 / 92%);
    transform: translateZ(2rem);
  }

  .club-logo img {
    width: min(100%, 18rem);
    height: auto;
    object-fit: contain;
  }
  .club-copy {
    position: relative;
    z-index: 2;
    transform: translateZ(1.5rem);
  }
  .club-copy p:not(.eyebrow) {
    max-width: 40rem;
    margin-top: 1rem;
    color: rgb(242 247 248 / 74%);
  }
  .club-copy > span {
    display: inline-block;
    margin-top: 2rem;
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 750;
  }

  .club-art,
  .club-art span {
    position: absolute;
    border-radius: 50%;
  }
  .club-art {
    z-index: -1;
    inset: 0;
  }
  .club-art span:nth-child(1) {
    top: -12rem;
    right: -8rem;
    width: 30rem;
    height: 30rem;
    border: 1px solid rgb(69 215 196 / 28%);
  }
  .club-art span:nth-child(2) {
    top: 2rem;
    right: 4rem;
    width: 18rem;
    height: 18rem;
    border: 1px solid rgb(255 255 255 / 12%);
  }
  .club-art span:nth-child(3) {
    right: 11rem;
    bottom: -4rem;
    width: 8rem;
    height: 8rem;
    background: rgb(69 215 196 / 12%);
    filter: blur(1rem);
  }

  @media (max-width: 48rem) {
    .club-card {
      grid-template-columns: 1fr;
    }
  }
</style>
