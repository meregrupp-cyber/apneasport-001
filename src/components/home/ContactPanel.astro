---
import { site } from '../../data/site';
import { routeFor, type Locale } from '../../i18n/routes';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<section class="contact-panel">
  <div>
    <p class="eyebrow">{locale === 'et' ? 'Võta ühendust' : 'Get in touch'}</p>
    <h2>{locale === 'et' ? 'Kontakt' : 'Contact'}</h2>
    <p>
      {
        locale === 'et'
          ? 'Üldküsimused, koostöö ja ametlik infovahetus.'
          : 'General enquiries, cooperation and official correspondence.'
      }
    </p>
  </div>
  <div class="contact-actions">
    <a href={`mailto:${site.email}`}>{site.email}</a>
    <a href={`tel:${site.phoneHref}`}>{site.phoneDisplay}</a>
    <a class="button button--primary" href={routeFor('contact', locale)}
      >{locale === 'et' ? 'Kõik kontaktandmed' : 'All contact details'}<span aria-hidden="true"
        >→</span
      ></a
    >
  </div>
</section>

<style>
  .contact-panel {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: end;
    gap: 2rem;
    padding: clamp(1.5rem, 5vw, 4.5rem);
    border-radius: var(--radius-lg);
    color: var(--color-foam);
    background:
      radial-gradient(circle at 88% 10%, rgb(69 215 196 / 22%), transparent 34%), var(--color-brand);
  }
  .contact-panel > div > p:not(.eyebrow) {
    margin-top: 1rem;
    color: rgb(242 247 248 / 76%);
  }
  .contact-actions {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    gap: 0.75rem;
  }
  .contact-actions > a:not(.button) {
    font-family: var(--font-display);
    font-weight: 650;
  }
  .contact-actions .button {
    margin-top: 1rem;
  }
  @media (max-width: 44rem) {
    .contact-panel {
      grid-template-columns: 1fr;
    }
  }
</style>
