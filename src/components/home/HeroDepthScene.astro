---
import { Image } from 'astro:assets';
import heroImage from '../../assets/eapsl/hero.png';
import { routeFor, type Locale } from '../../i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content =
  locale === 'et'
    ? {
        overline: 'Eesti Apneaspordi Liit · AIDA Estonia',
        lead: 'Arendame Eestis vabasukeldumist, veevõitlust, merineitsisporti ja nendega seotud allveespordialasid',
        primary: 'Avasta spordialad',
        secondary: 'Tutvu liiduga',
        heroAlt: 'EAPSL-i vabasukelduja tõusmas läbi avatud sinise vee',
      }
    : {
        overline: 'Estonian Apnea Sports League · AIDA Estonia',
        lead: 'We develop freediving, waterfighting, mermaiding and related underwater sports in Estonia — safely, fairly and openly.',
        primary: 'Explore the sports',
        secondary: 'About the League',
        heroAlt: 'EAPSL freediver ascending through open blue water',
      };
---

<section class="hero" data-depth-root>
  <div class="depth-background">
    <Image
      class="hero-image"
      src={heroImage}
      alt={content.heroAlt}
      widths={[768, 1100, 1440, 1916]}
      sizes="100vw"
      format="webp"
      quality={82}
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="surface-light" aria-hidden="true"></div>
    <canvas data-depth-canvas aria-hidden="true"></canvas>
  </div>
  <div class="container hero-content">
    <p class="eyebrow hero-overline">{content.overline}</p>
    <h1 class="hero-statement">{content.lead}</h1>
    <div class="button-row">
      <a class="button button--onphoto" href={routeFor('sports', locale)}
        >{content.primary}<span aria-hidden="true">↓</span></a
      >
      <a class="button button--secondary" href={routeFor('league', locale)}
        >{content.secondary}<span aria-hidden="true">→</span></a
      >
    </div>
  </div>
</section>

<script>
  import { initialiseDepthScene } from '../../scripts/depth-scene';

  const start = () => initialiseDepthScene();
  const idle = window.requestIdleCallback;
  if (typeof idle === 'function') {
    idle(start, { timeout: 1400 });
  } else {
    globalThis.setTimeout(start, 400);
  }
</script>

<style>
  .hero {
    position: relative;
    display: grid;
    /* The header is in normal flow now, so the hero fills what is left. */
    min-height: max(38rem, calc(88svh - var(--header-height)));
    align-items: center;
    overflow: hidden;
    color: var(--color-foam);
    background: var(--color-ink-deep);
    isolation: isolate;
  }

  .hero-content {
    position: relative;
    z-index: 3;
    padding-block: clamp(3.5rem, 7vw, 6rem);
  }

  /* Small white capitals, no plate and no frame. */
  .hero .hero-overline {
    margin-bottom: var(--space-4);
    color: var(--color-foam);
    font-family: var(--font-display);
    font-size: 0.74rem;
    font-weight: 650;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-shadow: 0 1px 12px rgb(14 31 41 / 55%);
  }

  /* The lead sentence carries the hero, set in the serif at display size. */
  .hero-statement {
    max-width: 26ch;
    font-family: var(--font-heading);
    font-size: clamp(1.9rem, 1.35rem + 1.75vw, 2.95rem);
    font-weight: 600;
    line-height: 1.14;
    letter-spacing: -0.012em;
    text-shadow: 0 1px 22px rgb(14 31 41 / 45%);
    text-wrap: balance;
  }

  .hero .button-row {
    align-items: center;
    margin-top: var(--space-5);
    gap: var(--space-4);
  }

  .depth-background,
  .depth-background::before,
  .surface-light,
  [data-depth-canvas] {
    position: absolute;
    inset: 0;
  }

  .depth-background {
    z-index: -1;
    overflow: hidden;
  }

  .hero-image {
    position: absolute;
    z-index: 1;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 66% center;
  }

  /* Readability scrim: weighted over the copy on the left, letting the water
     and light on the right stay visible. */
  .depth-background::before {
    z-index: 2;
    content: '';
    background: linear-gradient(
      100deg,
      rgb(14 31 41 / 86%) 0%,
      rgb(14 31 41 / 68%) 30%,
      rgb(14 31 41 / 26%) 56%,
      transparent 78%
    );
  }

  .surface-light {
    z-index: 3;
    top: -30%;
    right: -10%;
    left: auto;
    width: 60vw;
    height: 60vw;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(255 255 255 / 10%), transparent 66%);
    filter: blur(1.5rem);
    mix-blend-mode: screen;
  }

  [data-depth-canvas] {
    z-index: 4;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1s ease;
  }

  [data-depth-root][data-enhanced='true'] [data-depth-canvas] {
    opacity: 0.34;
  }

  @media (prefers-reduced-motion: no-preference) {
    .surface-light {
      animation: breathe 9s ease-in-out infinite alternate;
    }

    .hero-image {
      animation: hero-drift 26s ease-in-out infinite alternate;
    }
  }

  @keyframes breathe {
    to {
      transform: scale(1.1);
      opacity: 0.8;
    }
  }

  @keyframes hero-drift {
    from {
      transform: scale(1.02);
    }

    to {
      transform: scale(1.06) translateY(-0.6%);
    }
  }

  @media (max-width: 44rem) {
    .hero {
      min-height: max(34rem, calc(92svh - var(--header-height)));
    }

    .hero-content {
      align-self: end;
      padding-top: 6rem;
      padding-bottom: 3.5rem;
    }

    .hero-image {
      object-position: 62% center;
    }

    /* The copy sits low on a phone, so the scrim deepens from the bottom. */
    .depth-background::before {
      background: linear-gradient(
        180deg,
        rgb(14 31 41 / 6%) 0%,
        rgb(14 31 41 / 14%) 20%,
        rgb(14 31 41 / 30%) 46%,
        rgb(14 31 41 / 40%) 100%
      );
    }

    /* The copy block grows as the headline wraps, so on narrow screens the
       readability wash is anchored to the text itself rather than to a fixed
       share of the viewport. It bleeds past the container edges. */
    .hero-content::before {
      position: absolute;
      z-index: -1;
      inset: -1.5rem -50vw -1rem;
      content: '';
      background: linear-gradient(
        180deg,
        transparent 0%,
        rgb(14 31 41 / 62%) 14%,
        rgb(14 31 41 / 74%) 50%,
        rgb(14 31 41 / 78%) 100%
      );
    }

    .hero .button-row {
      align-items: flex-start;
      gap: var(--space-3);
    }
  }
</style>
