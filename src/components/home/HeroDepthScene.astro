---
import { Image } from 'astro:assets';
import heroImage from '../../assets/eapsl/hero.png';
import { routeFor, type Locale } from '../../i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content =
  locale === 'et'
    ? {
        overline: 'Eesti Apneaspordi Liit · AIDA Estonia',
        title: 'Üks hingetõmme. Mitu maailma.',
        lead: 'Arendame Eestis vabasukeldumist, veevõitlust, merineitsisporti ja nendega seotud allveespordialasid — ohutult, ausalt ja avatult.',
        primary: 'Avasta spordialad',
        secondary: 'Tutvu liiduga',
        depth: 'Liigu sügavamale',
        heroAlt: 'EAPSL-i vabasukelduja tõusmas läbi avatud sinise vee',
      }
    : {
        overline: 'Estonian Apnea Sports League · AIDA Estonia',
        title: 'One breath. Many worlds.',
        lead: 'We develop freediving, waterfighting, mermaiding and related underwater sports in Estonia — safely, fairly and openly.',
        primary: 'Explore the sports',
        secondary: 'About the League',
        depth: 'Move deeper',
        heroAlt: 'EAPSL freediver ascending through open blue water',
      };
---

<section class="hero" data-depth-root>
  <div class="depth-background">
    <Image
      class="hero-image"
      src={heroImage}
      alt={content.heroAlt}
      widths={[768, 1100, 1440, 1916]}
      sizes="100vw"
      format="webp"
      quality={82}
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="surface-light" aria-hidden="true"></div>
    <canvas data-depth-canvas aria-hidden="true"></canvas>
  </div>
  <div class="container hero-content">
    <p class="eyebrow">{content.overline}</p>
    <h1>{content.title}</h1>
    <p class="lede">{content.lead}</p>
    <div class="button-row">
      <a class="button button--primary" href={routeFor('sports', locale)}
        >{content.primary}<span aria-hidden="true">↓</span></a
      >
      <a class="button button--secondary" href={routeFor('league', locale)}
        >{content.secondary}<span aria-hidden="true">→</span></a
      >
    </div>
  </div>
  <a class="depth-cue" href="#trust-strip">
    <span>{content.depth}</span>
    <span class="depth-line" aria-hidden="true"></span>
  </a>
</section>

<script>
  import { initialiseDepthScene } from '../../scripts/depth-scene';

  const start = () => initialiseDepthScene();
  const idle = window.requestIdleCallback;
  if (typeof idle === 'function') {
    idle(start, { timeout: 1400 });
  } else {
    globalThis.setTimeout(start, 400);
  }
</script>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: max(46rem, 94svh);
    align-items: center;
    overflow: hidden;
    color: var(--color-foam);
    background: var(--color-abyss);
    isolation: isolate;
  }

  .hero-content {
    position: relative;
    z-index: 3;
    padding-top: 6rem;
    padding-bottom: 4rem;
    text-shadow: 0 0.08em 1.2em rgb(2 11 20 / 60%);
  }

  .hero-content .button {
    text-shadow: none;
  }

  .hero h1 {
    max-width: 12ch;
  }

  .hero .lede {
    max-width: 38rem;
  }

  .depth-background,
  .depth-background::before,
  .depth-background::after,
  .surface-light,
  [data-depth-canvas] {
    position: absolute;
    inset: 0;
  }

  .depth-background {
    z-index: -1;
    overflow: hidden;
  }

  .hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 66% center;
  }

  /* Readability scrim: darker over the copy on the left, clear over the athlete. */
  .depth-background::before {
    content: '';
    background: linear-gradient(
      100deg,
      rgb(2 11 20 / 78%) 0%,
      rgb(2 11 20 / 46%) 34%,
      rgb(2 11 20 / 8%) 58%,
      transparent 74%
    );
  }

  /* Depth fade so the hero dissolves into the dark strip below instead of a hard edge. */
  .depth-background::after {
    content: '';
    background: linear-gradient(
      180deg,
      rgb(2 11 20 / 30%) 0%,
      transparent 22%,
      transparent 62%,
      var(--color-abyss) 100%
    );
  }

  .surface-light {
    top: -30%;
    right: -10%;
    left: auto;
    width: 60vw;
    height: 60vw;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgb(69 215 196 / 16%),
      rgb(15 95 131 / 6%) 42%,
      transparent 68%
    );
    filter: blur(1.5rem);
    mix-blend-mode: screen;
  }

  [data-depth-canvas] {
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1s ease;
  }

  [data-depth-root][data-enhanced='true'] [data-depth-canvas] {
    opacity: 0.5;
  }

  .depth-cue {
    position: absolute;
    z-index: 5;
    right: 2rem;
    bottom: 2rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: rgb(242 247 248 / 66%);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-decoration: none;
    text-transform: uppercase;
    writing-mode: vertical-rl;
  }

  .depth-line {
    width: 1px;
    height: 3.5rem;
    background: linear-gradient(var(--color-aqua), transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .surface-light {
      animation: breathe 9s ease-in-out infinite alternate;
    }

    .hero-image {
      animation: hero-drift 26s ease-in-out infinite alternate;
    }
  }

  @keyframes breathe {
    to {
      transform: scale(1.1);
      opacity: 0.8;
    }
  }

  @keyframes hero-drift {
    from {
      transform: scale(1.02);
    }

    to {
      transform: scale(1.06) translateY(-0.6%);
    }
  }

  @media (max-width: 44rem) {
    .hero {
      min-height: max(42rem, 100svh);
    }

    .hero-content {
      align-self: end;
      padding-top: 9rem;
      padding-bottom: 5.5rem;
    }

    .hero-image {
      object-position: 62% center;
    }

    /* On small screens the copy sits low, so deepen the scrim from the bottom instead. */
    .depth-background::before {
      background:
        linear-gradient(
          180deg,
          rgb(2 11 20 / 22%) 0%,
          rgb(2 11 20 / 14%) 20%,
          rgb(2 11 20 / 62%) 46%,
          rgb(2 11 20 / 92%) 100%
        ),
        linear-gradient(285deg, transparent 40%, rgb(2 11 20 / 52%) 80%);
    }

    .depth-cue {
      display: none;
    }
  }
</style>
