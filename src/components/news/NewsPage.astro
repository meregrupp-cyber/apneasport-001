---
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Locale } from '../../i18n/routes';
import { t } from '../../i18n/ui';
import { newsPath, publishedNews } from '../../data/news';
import PageHero from '../common/PageHero.astro';
import NewsCard from './NewsCard.astro';
import SocialFeedFallback from './SocialFeedFallback.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = t(locale);
const news = await publishedNews(locale);
const content =
  locale === 'et'
    ? {
        title: 'Uudised',
        eyebrow: 'EAPSL-i enda arhiiv',
        intro: 'Kinnitatud uudised, teated ja spordilood ühes püsivas arhiivis.',
        description: 'Eesti Apneaspordi Liidu uudised ja ametlikud teated.',
        empty:
          'Esimesed kinnitatud uudised lisanduvad siia. Toimetuse mustandeid ega sotsiaalmeedia postitusi automaatselt ei avaldata.',
      }
    : {
        title: 'News',
        eyebrow: 'EAPSL’s own archive',
        intro: 'Approved news, notices and sports stories in one persistent archive.',
        description: 'News and official notices from the Estonian Apnea Sports League.',
        empty:
          'The first approved news items will appear here. Editorial drafts and social posts are not published automatically.',
      };
---

<BaseLayout title={content.title} description={content.description} {locale} routeKey="news">
  <main id="main-content">
    <PageHero {locale} eyebrow={content.eyebrow} title={content.title} intro={content.intro} />
    <section class="section">
      <div class="container">
        {news.length === 0 && <p class="status-note news-empty">{content.empty}</p>}
        {
          news.length > 0 && (
            <div class="news-list">
              {news.map((entry) => (
                <NewsCard
                  {locale}
                  title={entry.data.title}
                  excerpt={entry.data.excerpt}
                  publishedAt={entry.data.publishedAt}
                  href={newsPath(entry)}
                  author={entry.data.author}
                  image={entry.data.image}
                  imageAlt={entry.data.imageAlt}
                  cta={copy.learnMore}
                />
              ))}
            </div>
          )
        }
        <SocialFeedFallback {locale} />
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .news-empty {
    margin-bottom: 1.5rem;
  }

  .news-list {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }
</style>
