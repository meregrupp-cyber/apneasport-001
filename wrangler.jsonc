{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apneasport",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-08-08",
  // Athlete status applications wait here until the applicant confirms their
  // email. Created 2026-08-21 in the EEUR region; the schema lives in
  // migrations/0001_athlete_applications.sql and is already applied.
  "d1_databases": [
    {
      "binding": "ATHLETE_APPLICATIONS",
      "database_name": "apneasport-athlete-applications",
      "database_id": "5e6d0032-2a39-4cb8-b5bb-ea2b9c947bd5",
    },
  ],
}
